{
  "name": "lurkbox-decky",
  "version": "0.1.0",
  "description": "Go-live notifications for the channels you follow, from the Lurkbox Decky companion",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "package": "sh package.sh",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "author": "aronwk-aaron",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode-generator": "^2.0.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lurkbox/decky-lurkbox.git"
  }
}
